<div class="fluig-style-guide">
    <div class="form-group">
        <label for="tituloWidget">Título da widget</label>
        <input 
            type="text" 
            class="form-control" 
            id="tituloWidget" 
            name="tituloWidget" 
            value="${tituloWidget!'Bolão Copa 2026'}">
    </div>

    <div class="form-group">
        <label for="descricaoWidget">Descrição</label>
        <input 
            type="text" 
            class="form-control" 
            id="descricaoWidget" 
            name="descricaoWidget" 
            value="${descricaoWidget!'Simulador de bolão da Copa do Mundo 2026'}">
    </div>
</div>